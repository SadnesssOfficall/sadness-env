{
  "variables": {
    "NODE_ENV": {
      "type": "enum",
      "values": ["development", "test", "production"],
      "default": "development",
      "description": "Runtime environment"
    },
    "PORT": {
      "type": "port",
      "default": 3000,
      "description": "HTTP port the server listens on"
    },
    "DATABASE_URL": {
      "type": "url",
      "protocols": ["postgres", "postgresql"],
      "secret": true,
      "description": "PostgreSQL connection string"
    },
    "REDIS_URL": {
      "type": "url",
      "protocols": ["redis", "rediss"],
      "required": false,
      "description": "Optional Redis connection string"
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32,
      "secret": true,
      "description": "Key used to sign access tokens"
    },
    "REQUEST_TIMEOUT_MS": {
      "type": "integer",
      "min": 100,
      "max": 60000,
      "default": 5000
    },
    "ENABLE_METRICS": {
      "type": "boolean",
      "default": false
    }
  }
}
